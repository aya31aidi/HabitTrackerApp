@model HabitTrackerApp.Models.HabitRecord

@{
    ViewData["Title"] = "Habit Record Details";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0"><i class="bi bi-clipboard-check"></i> Habit Record Details</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-secondary">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3 text-secondary">Completed</dt>
                <dd class="col-sm-9">@Model.IsCompleted</dd>

                <dt class="col-sm-3 text-secondary">Habit Goal</dt>
                <dd class="col-sm-9">@Model.Habit.Goal</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>
</div>
