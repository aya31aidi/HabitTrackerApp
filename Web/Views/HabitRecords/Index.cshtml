@model IEnumerable<HabitTrackerApp.Models.HabitRecord>

@{
    ViewData["Title"] = "Habit Records";
}

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Habit Records</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New Habit
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                <th>@Html.DisplayNameFor(model => model.First().Date)</th>
                <th>@Html.DisplayNameFor(model => model.First().IsCompleted)</th>
                <th>Habit Name</th>
                <th>Goal</th>
                <th>User Email</th>
                <th>Actions</th>
               </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
        <tr>
            <td>@item.Date.ToString("yyyy-MM-dd")</td>
            <td>@(item.IsCompleted ? "Completed" : "Not Completed")</td>
            <td>@item.Habit?.Name</td>
            <td>@item.Habit?.Goal</td>
            <td>@item.Habit.User?.Email</td>
            <td>
                <div class="d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-2">
                        <i class="bi bi-info-circle"></i> Details
                    </a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm me-2">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </td>
        </tr>
                }
</tbody>
        </table>
    </div>
</div>

@section Scripts {
            <script>
                setTimeout(function () {
                    var alertEl = document.querySelector('.alert');
                    if (alertEl) {
                        alertEl.classList.remove('show');
                        setTimeout(() => {
                            var alert = bootstrap.Alert.getOrCreateInstance(alertEl);
                            alert.close();
                        }, 300); // temps du fade
                    }
                }, 5000);
            </script>
}
