@model IEnumerable<HabitTrackerApp.Models.HabitRecord>

@{
    ViewData["Title"] = "History";
    var isAdmin = ViewBag.IsAdmin == true;
    var status = ViewBag.Status as string;
    var habitId = ViewBag.HabitId as int?;
    var records = Model.ToList();
    var done = records.Count(r => r.IsCompleted);
}

<div class="page-header">
    <div>
        <h1>History</h1>
        <p>Every check-in, day by day. @records.Count @(records.Count == 1 ? "record" : "records") · @done done</p>
    </div>
    <a asp-action="Create" asp-route-habitId="@habitId" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i> Log a day</a>
</div>

<div class="panel mb-4 py-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5 col-lg-4">
            <div class="input-icon">
                <i class="bi bi-check2-circle"></i>
                <select name="habitId" class="form-select" asp-items="ViewBag.Habits" onchange="this.form.submit()" aria-label="Filter by habit">
                    <option value="">All habits</option>
                </select>
            </div>
        </div>
        <div class="col-md-auto">
            <div class="d-flex gap-2">
                <a class="filter-pill @(string.IsNullOrEmpty(status) ? "active" : "")" asp-route-habitId="@habitId">All</a>
                <a class="filter-pill @(status == "done" ? "active" : "")" asp-route-habitId="@habitId" asp-route-status="done"><i class="bi bi-check-circle"></i> Done</a>
                <a class="filter-pill @(status == "missed" ? "active" : "")" asp-route-habitId="@habitId" asp-route-status="missed"><i class="bi bi-x-circle"></i> Missed</a>
            </div>
        </div>
        <input type="hidden" name="status" value="@status" />
        <div class="col-md ms-md-auto">
            <div class="search-box ms-md-auto" style="max-width:320px">
                <i class="bi bi-search"></i>
                <input type="search" class="form-control" placeholder="Quick search..." data-filter-input aria-label="Search records" />
            </div>
        </div>
    </form>
</div>

@if (records.Count == 0)
{
    <div class="panel empty-state reveal">
        <div class="empty-icon"><i class="bi bi-journal"></i></div>
        <h3>No records found</h3>
        <p>Check a habit from the dashboard or log a past day here, it will show up in this list.</p>
        <a asp-action="Create" asp-route-habitId="@habitId" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i> Log a day</a>
    </div>
}
else
{
    <div class="card table-card reveal">
        <div class="table-responsive">
            <table class="table table-modern table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Habit</th>
                        <th>Status</th>
                        @if (isAdmin)
                        {
                            <th>User</th>
                        }
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in records)
                    {
                        <tr data-filter-item data-filter-text="@($"{item.Date:dddd d MMMM yyyy} {item.Habit?.Name} {item.Habit?.User?.Email} {(item.IsCompleted ? "done" : "missed")}")">
                            <td>
                                <div class="fw-semibold">@item.Date.ToString("d MMM yyyy")</div>
                                <small class="text-muted">@(item.Date.Date == DateTime.Today ? "Today" : item.Date.Date == DateTime.Today.AddDays(-1) ? "Yesterday" : item.Date.ToString("dddd"))</small>
                            </td>
                            <td>
                                <a asp-controller="Habits" asp-action="Details" asp-route-id="@item.HabitId" class="d-flex align-items-center gap-2 text-reset @CategoryStyle.Tone(item.Habit?.CategoryId ?? 0)">
                                    <span class="tone-icon" style="width:34px;height:34px;min-width:34px;font-size:1rem"><i class="bi @CategoryStyle.Icon(item.Habit?.Category?.Name)"></i></span>
                                    <span class="fw-semibold">@item.Habit?.Name</span>
                                </a>
                            </td>
                            <td>
                                @if (item.IsCompleted)
                                {
                                    <span class="status-pill done"><i class="bi bi-check-circle"></i> Done</span>
                                }
                                else
                                {
                                    <span class="status-pill missed"><i class="bi bi-x-circle"></i> Missed</span>
                                }
                            </td>
                            @if (isAdmin)
                            {
                                <td class="text-muted">@item.Habit?.User?.Email</td>
                            }
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel empty-state d-none mt-3" data-filter-empty>
        <div class="empty-icon"><i class="bi bi-search"></i></div>
        <h3>Nothing matches this search</h3>
    </div>
}
