@model HabitTrackerApp.Models.HabitRecord

@{
    ViewData["Title"] = "Create Habit Record";
}

<h1 class="mb-4">Create a Habit Record</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-3">
                        <input class="form-check-input" asp-for="IsCompleted" />
                        <label class="form-check-label" asp-for="IsCompleted">
                            @Html.DisplayNameFor(model => model.IsCompleted)
                        </label>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="HabitId" class="form-label"></label>
                        <select asp-for="HabitId" class="form-select" asp-items="ViewBag.HabitId">
                            <option value="">-- Select a Habit --</option>
                        </select>
                        <span asp-validation-for="HabitId" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Save Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}