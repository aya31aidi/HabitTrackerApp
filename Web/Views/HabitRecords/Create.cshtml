@model HabitTrackerApp.Models.HabitRecord

@{
    ViewData["Title"] = "Log a Day";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> History</a>
<div class="page-header">
    <div>
        <h1>Log a day</h1>
        <p>Forgot to check in? Record a past day here. For today, the check button on the dashboard is quicker.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Create" method="post" data-loading>
                <partial name="_RecordForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Save record" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
