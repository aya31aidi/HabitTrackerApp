@model HabitTrackerApp.Models.HabitRecord

@{
    ViewData["Title"] = "Delete Record";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> History</a>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="panel danger-card reveal">
            <div class="danger-icon"><i class="bi bi-trash3"></i></div>
            <h1 class="h3">Delete this record?</h1>
            <p class="text-muted">This action cannot be undone. Streaks and completion rate will be recalculated without it.</p>

            <dl class="detail-list my-4">
                <div><dt>Habit</dt><dd>@Model.Habit?.Name</dd></div>
                <div><dt>Date</dt><dd>@Model.Date.ToString("dddd d MMMM yyyy")</dd></div>
                <div><dt>Status</dt><dd>@(Model.IsCompleted ? "Done" : "Missed")</dd></div>
            </dl>

            <form asp-action="Delete" method="post" data-loading>
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger" data-loading-text="Deleting..."><i class="bi bi-trash me-1"></i> Yes, delete it</button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
