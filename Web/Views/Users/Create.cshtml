@model UserFormViewModel

@{
    ViewData["Title"] = "New User";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Users</a>
<div class="page-header">
    <div>
        <h1>Create a user</h1>
        <p>The account can sign in right away with this email and password.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Create" method="post" data-loading>
                <partial name="_UserForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Create account" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
