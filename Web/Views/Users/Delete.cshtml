@model HabitTrackerApp.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Users</a>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="panel danger-card reveal">
            <div class="danger-icon"><i class="bi bi-person-x"></i></div>
            <h1 class="h3">Delete @Model.Name?</h1>
            <p class="text-muted">This action is irreversible. The account and everything it created will be removed.</p>

            <dl class="detail-list my-4">
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Member since</dt><dd>@Model.CreatedAt.ToString("d MMMM yyyy")</dd></div>
                <div><dt>Habits that will be removed</dt><dd>@Model.Habits.Count</dd></div>
                <div><dt>Reminders that will be removed</dt><dd>@Model.Reminders.Count</dd></div>
            </dl>

            <form asp-action="Delete" method="post" data-loading>
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger" data-loading-text="Deleting..."><i class="bi bi-trash me-1"></i> Yes, delete the account</button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
