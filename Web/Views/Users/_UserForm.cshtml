@model UserFormViewModel
@{
    var isEdit = Model.Id != 0;
    var submitText = ViewData["SubmitText"] as string ?? "Save";
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label">Full name</label>
    <div class="input-icon">
        <i class="bi bi-person"></i>
        <input asp-for="Name" class="form-control" placeholder="Jane Doe" maxlength="100" />
    </div>
    <span asp-validation-for="Name" class="small"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <div class="input-icon">
        <i class="bi bi-envelope"></i>
        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
    </div>
    <span asp-validation-for="Email" class="small"></span>
</div>

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <label asp-for="Password" class="form-label">@(isEdit ? "New password" : "Password")</label>
        <small class="text-muted fw-semibold" data-strength-label="Password"></small>
    </div>
    <div class="input-icon">
        <i class="bi bi-lock"></i>
        <input asp-for="Password" class="form-control" placeholder="@(isEdit ? "Leave blank to keep the current one" : "At least 6 characters")" autocomplete="new-password" />
        <button type="button" class="input-action" data-password-toggle="Password" aria-label="Show password">
            <i class="bi bi-eye"></i>
        </button>
    </div>
    <div class="strength-meter" data-password-strength="Password" data-level="0">
        <span></span><span></span><span></span><span></span>
    </div>
    <span asp-validation-for="Password" class="small"></span>
</div>

@if (isEdit)
{
    <p class="small text-muted mb-4"><i class="bi bi-calendar-check me-1"></i>Member since @Model.CreatedAt.ToString("d MMMM yyyy")</p>
}

<div class="d-flex flex-wrap gap-2 mt-4">
    <button type="submit" class="btn btn-primary" data-loading-text="Saving...">
        <i class="bi bi-check-lg me-1"></i> @submitText
    </button>
    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
</div>
