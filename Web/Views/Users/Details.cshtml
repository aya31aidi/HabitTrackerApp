@model HabitTrackerApp.Models.User

@{
    ViewData["Title"] = Model.Name;
    var habits = (List<HabitSummary>)ViewBag.Habits;
    var upcomingReminders = Model.Reminders.Count(r => r.ReminderTime >= DateTime.Now);
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Users</a>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel reveal text-center">
            <span class="avatar avatar-lg mb-3">@ClaimsPrincipalExtensions.Initials(Model.Name)</span>
            <h1 class="h4 mb-1">@Model.Name</h1>
            <p class="text-muted mb-3">@Model.Email</p>

            <dl class="detail-list text-start">
                <div><dt>Member since</dt><dd>@Model.CreatedAt.ToString("d MMMM yyyy")</dd></div>
                <div><dt>Habits</dt><dd>@habits.Count</dd></div>
                <div><dt>Done today</dt><dd>@habits.Count(h => h.DoneToday) / @habits.Count</dd></div>
                <div><dt>Upcoming reminders</dt><dd>@upcomingReminders</dd></div>
            </dl>

            <div class="d-flex gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-grow-1"><i class="bi bi-pencil me-1"></i> Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-ghost text-danger" title="Delete"><i class="bi bi-trash"></i></a>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <section class="panel reveal" style="--i:1">
            <div class="panel-title">
                <h2><i class="bi bi-check2-circle me-2 text-primary"></i>Habits</h2>
            </div>
            @if (habits.Count == 0)
            {
                <p class="text-muted mb-0">This user hasn't created any habit yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>Habit</th>
                                <th style="min-width:150px">Completion</th>
                                <th class="text-center">Streak</th>
                                <th class="text-center">Today</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in habits)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Habits" asp-action="Details" asp-route-id="@item.Habit.Id" class="fw-semibold text-reset">@item.Habit.Name</a>
                                        <div><span class="chip @CategoryStyle.Tone(item.Habit.CategoryId)">@item.Habit.Category?.Name</span></div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress-thin flex-grow-1">
                                                <div class="progress-bar" style="width:0" data-width="@item.CompletionRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"></div>
                                            </div>
                                            <span class="small fw-bold">@item.CompletionRate.ToString("0")%</span>
                                        </div>
                                    </td>
                                    <td class="text-center"><span class="streak @(item.CurrentStreak == 0 ? "is-cold" : "")"><i class="bi bi-fire"></i> @item.CurrentStreak</span></td>
                                    <td class="text-center">
                                        @if (item.DoneToday)
                                        {
                                            <span class="status-pill done"><i class="bi bi-check-lg"></i></span>
                                        }
                                        else
                                        {
                                            <span class="status-pill past"><i class="bi bi-dash"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
