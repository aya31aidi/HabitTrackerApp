@model IEnumerable<UserRow>

@{
    ViewData["Title"] = "Users";
    var users = Model.ToList();
    var activeThisWeek = users.Count(u => u.LastActivity >= DateTime.Today.AddDays(-6));
}

<div class="page-header">
    <div>
        <h1>Users</h1>
        <p>@users.Count registered · @activeThisWeek active this week</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" placeholder="Search by name or email..." data-filter-input aria-label="Search users" />
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> New user</a>
    </div>
</div>

@if (users.Count == 0)
{
    <div class="panel empty-state reveal">
        <div class="empty-icon"><i class="bi bi-people"></i></div>
        <h3>No users yet</h3>
        <p>Accounts created from the sign up page or from here will appear in this list.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Create a user</a>
    </div>
}
else
{
    <div class="card table-card reveal">
        <div class="table-responsive">
            <table class="table table-modern table-hover">
                <thead>
                    <tr>
                        <th>User</th>
                        <th class="text-center">Habits</th>
                        <th class="text-center">Reminders</th>
                        <th>Last activity</th>
                        <th>Member since</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in users)
                    {
                        <tr data-filter-item data-filter-text="@($"{item.Name} {item.Email}")">
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="d-flex align-items-center gap-3 text-reset">
                                    <span class="avatar">@ClaimsPrincipalExtensions.Initials(item.Name)</span>
                                    <span class="overflow-hidden">
                                        <span class="fw-semibold d-block text-truncate">@item.Name</span>
                                        <small class="text-muted d-block text-truncate">@item.Email</small>
                                    </span>
                                </a>
                            </td>
                            <td class="text-center fw-semibold">@item.HabitCount</td>
                            <td class="text-center fw-semibold">@item.ReminderCount</td>
                            <td>
                                @if (item.LastActivity.HasValue)
                                {
                                    <span class="status-pill @(item.LastActivity >= DateTime.Today.AddDays(-6) ? "done" : "past")">
                                        @item.LastActivity.Value.ToString("d MMM yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">No activity</span>
                                }
                            </td>
                            <td class="text-muted">@item.CreatedAt.ToString("d MMM yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon text-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel empty-state d-none mt-3" data-filter-empty>
        <div class="empty-icon"><i class="bi bi-search"></i></div>
        <h3>No user matches this search</h3>
    </div>
}
