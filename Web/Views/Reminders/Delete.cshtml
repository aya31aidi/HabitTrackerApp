@model HabitTrackerApp.Models.Reminder

@{
    ViewData["Title"] = "Delete Reminder";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Reminders</a>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="panel danger-card reveal">
            <div class="danger-icon"><i class="bi bi-bell-slash"></i></div>
            <h1 class="h3">Delete this reminder?</h1>
            <p class="text-muted">This action is irreversible.</p>

            <dl class="detail-list my-4">
                <div><dt>Message</dt><dd>@Model.Message</dd></div>
                <div><dt>When</dt><dd>@Model.ReminderTime.ToString("dddd d MMMM yyyy, HH:mm")</dd></div>
                <div><dt>Habit</dt><dd>@Model.Habit?.Name</dd></div>
                <div><dt>User</dt><dd>@Model.User?.Email</dd></div>
            </dl>

            <form asp-action="Delete" method="post" data-loading>
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger" data-loading-text="Deleting..."><i class="bi bi-trash me-1"></i> Yes, delete it</button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
