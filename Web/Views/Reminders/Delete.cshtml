@model HabitTrackerApp.Models.Reminder

@{
    ViewData["Title"] = "Delete a reminder";
}

<h1 class="text-danger mb-4">⚠️ Delete a reminder</h1>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this reminder?</strong> This action is irreversible.
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Reminder details</h5>
        <dl class="row mb-0">
            <dt class="col-sm-4">Message</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Message)</dd>

            <dt class="col-sm-4">Reminder Time</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.ReminderTime)</dd>

            <dt class="col-sm-4">Habit</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Habit.Goal)</dd>

            <dt class="col-sm-4">User</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.User.Email)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-danger">✅ Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">❌ Cancel</a>
    </div>
</form>
