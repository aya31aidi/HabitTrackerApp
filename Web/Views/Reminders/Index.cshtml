@model IEnumerable<HabitTrackerApp.Models.Reminder>

@{
    ViewData["Title"] = "Reminders";
    var isAdmin = ViewBag.IsAdmin == true;
    var now = DateTime.Now;
    var upcoming = Model.Where(r => r.ReminderTime >= now).OrderBy(r => r.ReminderTime).ToList();
    var past = Model.Where(r => r.ReminderTime < now).OrderByDescending(r => r.ReminderTime).ToList();
}

<div class="page-header">
    <div>
        <h1>Reminders</h1>
        <p>@upcoming.Count upcoming · @past.Count past. Reminders pop up while the app is open.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-ghost" data-enable-notifications>
            <i class="bi bi-bell me-1"></i> Enable notifications
        </button>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> New reminder</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="panel empty-state reveal">
        <div class="empty-icon"><i class="bi bi-alarm"></i></div>
        <h3>No reminders yet</h3>
        <p>A nudge at the right moment is often all it takes. Schedule one for a habit that tends to slip.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Schedule a reminder</a>
    </div>
}
else
{
    <ul class="nav nav-pills gap-2 mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="filter-pill active" data-bs-toggle="pill" data-bs-target="#tab-upcoming" type="button" role="tab">
                <i class="bi bi-hourglass-split"></i> Upcoming <span class="badge rounded-pill text-bg-light ms-1">@upcoming.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="filter-pill" data-bs-toggle="pill" data-bs-target="#tab-past" type="button" role="tab">
                <i class="bi bi-clock-history"></i> Past <span class="badge rounded-pill text-bg-light ms-1">@past.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-upcoming" role="tabpanel">
            @if (upcoming.Count == 0)
            {
                <div class="panel text-muted">Nothing scheduled ahead.</div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @{ var i = 0; }
                    @foreach (var item in upcoming)
                    {
                        <partial name="_ReminderItem" model="item" view-data='new ViewDataDictionary(ViewData) { ["Index"] = i++, ["IsAdmin"] = isAdmin }' />
                    }
                </div>
            }
        </div>
        <div class="tab-pane fade" id="tab-past" role="tabpanel">
            @if (past.Count == 0)
            {
                <div class="panel text-muted">No past reminders.</div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @foreach (var item in past)
                    {
                        <partial name="_ReminderItem" model="item" view-data='new ViewDataDictionary(ViewData) { ["IsAdmin"] = isAdmin }' />
                    }
                </div>
            }
        </div>
    </div>
}
