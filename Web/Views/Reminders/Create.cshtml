@model HabitTrackerApp.Models.Reminder

@{
    ViewData["Title"] = "New Reminder";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Reminders</a>
<div class="page-header">
    <div>
        <h1>Schedule a reminder</h1>
        <p>Pick a habit, write a short nudge and choose when it should pop up.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Create" method="post" data-loading>
                <partial name="_ReminderForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Schedule reminder" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
