@model HabitTrackerApp.Models.Reminder

@{
    ViewData["Title"] = "Create a reminder";
}

<h1 class="mb-4">Create a reminder</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Message" class="form-label"></label>
                        <input asp-for="Message" class="form-control" placeholder="Reminder message" />
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ReminderTime" class="form-label"></label>
                        <input asp-for="ReminderTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ReminderTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="HabitId" class="form-label">Habit</label>
                        <select asp-for="HabitId" class="form-select" asp-items="ViewBag.HabitId">
                            <option value="">-- Select a habit --</option>
                        </select>
                        <span asp-validation-for="HabitId" class="text-danger"></span>
                    </div>
                    @if (ViewBag.Role == "Admin")
                    {
                        <div class="form-group mb-4">
                            <label asp-for="UserId" class="form-label">User</label>
                            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                                <option value="">-- Select a user --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    }
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Create Reminder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}