@model HabitTrackerApp.Models.Reminder
@{
    var submitText = ViewData["SubmitText"] as string ?? "Save";
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="HabitId" class="form-label"></label>
    <div class="input-icon">
        <i class="bi bi-check2-circle"></i>
        <select asp-for="HabitId" class="form-select" asp-items="ViewBag.HabitId">
            <option value="">Select a habit</option>
        </select>
    </div>
    <span asp-validation-for="HabitId" class="small"></span>
</div>

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <label asp-for="Message" class="form-label"></label>
        <small class="text-muted" data-char-output="Message"></small>
    </div>
    <div class="input-icon">
        <i class="bi bi-chat-text"></i>
        <input asp-for="Message" class="form-control" placeholder="e.g. Time for a 20 minute walk!" maxlength="200" data-char-count="200" />
    </div>
    <span asp-validation-for="Message" class="small"></span>
</div>

<div class="mb-2">
    <label asp-for="ReminderTime" class="form-label"></label>
    <div class="input-icon">
        <i class="bi bi-calendar-event"></i>
        <input asp-for="ReminderTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
    </div>
    <span asp-validation-for="ReminderTime" class="small"></span>
</div>

@* Quick presets fill the date picker in one click *@
<div class="d-flex flex-wrap gap-2 mb-4">
    <button type="button" class="filter-pill" data-time-preset="60">In 1 hour</button>
    <button type="button" class="filter-pill" data-time-preset="tonight">Tonight 8 PM</button>
    <button type="button" class="filter-pill" data-time-preset="tomorrow">Tomorrow 8 AM</button>
</div>

<div class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-primary" data-loading-text="Saving...">
        <i class="bi bi-check-lg me-1"></i> @submitText
    </button>
    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
</div>

<script>
    (function () {
        const input = document.getElementById('ReminderTime');
        const pad = n => String(n).padStart(2, '0');
        const toLocalValue = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());

        document.querySelectorAll('[data-time-preset]').forEach(btn => {
            btn.addEventListener('click', () => {
                const preset = btn.dataset.timePreset;
                const date = new Date();
                if (preset === 'tonight') {
                    date.setHours(20, 0, 0, 0);
                    if (date < new Date()) date.setDate(date.getDate() + 1);
                } else if (preset === 'tomorrow') {
                    date.setDate(date.getDate() + 1);
                    date.setHours(8, 0, 0, 0);
                } else {
                    date.setMinutes(date.getMinutes() + parseInt(preset, 10), 0, 0);
                }
                input.value = toLocalValue(date);
                input.dispatchEvent(new Event('change'));

                document.querySelectorAll('[data-time-preset]').forEach(b => b.classList.toggle('active', b === btn));
            });
        });
    })();
</script>
