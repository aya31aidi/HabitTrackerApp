@model HabitTrackerApp.Models.Reminder

@{
    ViewData["Title"] = "Edit Reminder";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Reminders</a>
<div class="page-header">
    <div>
        <h1>Edit reminder</h1>
    </div>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-ghost text-danger"><i class="bi bi-trash me-1"></i> Delete</a>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Edit" method="post" data-loading>
                <partial name="_ReminderForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Save changes" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
