@model StatisticsViewModel

@{
    ViewData["Title"] = "Statistics";
    var isAdmin = ViewBag.IsAdmin == true;
    var top = Model.TopHabit;
    var rank = 0;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-header">
    <div>
        <h1>Statistics</h1>
        <p>Calculated live from the check-ins, nothing to fill in by hand.</p>
    </div>
    <form asp-action="Recalculate" method="post" data-loading>
        <button type="submit" class="btn btn-ghost" data-loading-text="Recalculating..." title="Rebuild the stored statistics (used by the desktop app)">
            <i class="bi bi-arrow-repeat me-1"></i> Recalculate
        </button>
    </form>
</div>

@if (Model.Habits.Count == 0)
{
    <div class="panel empty-state reveal">
        <div class="empty-icon"><i class="bi bi-bar-chart-line"></i></div>
        <h3>No data to show yet</h3>
        <p>Create a habit and check it in for a few days, the charts fill up on their own.</p>
        <a asp-controller="Habits" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create a habit</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card stat-card reveal" style="--i:1">
                <span class="stat-icon icon-success"><i class="bi bi-check2-all"></i></span>
                <div>
                    <div class="stat-value" data-count-to="@Model.TotalCompletions">0</div>
                    <div class="stat-label">Total check-ins</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card stat-card reveal" style="--i:2">
                <span class="stat-icon icon-primary"><i class="bi bi-percent"></i></span>
                <div>
                    <div class="stat-value" data-count-to="@Model.AverageRate.ToString(invariant)" data-decimals="1" data-suffix="%">0%</div>
                    <div class="stat-label">Average completion</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card stat-card reveal" style="--i:3">
                <span class="stat-icon icon-flame"><i class="bi bi-fire"></i></span>
                <div>
                    <div class="stat-value" data-count-to="@Model.BestStreak">0</div>
                    <div class="stat-label">Longest streak ever</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card stat-card reveal" style="--i:4">
                <span class="stat-icon icon-warning"><i class="bi bi-trophy"></i></span>
                <div class="overflow-hidden">
                    <div class="stat-value text-truncate fs-5">@top?.Habit.Name</div>
                    <div class="stat-label">Most consistent habit</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <section class="panel reveal h-100" style="--i:2">
                <div class="panel-title">
                    <h2><i class="bi bi-graph-up me-2 text-primary"></i>Last @Model.TrendDays days</h2>
                    <small class="text-muted">habits completed per day</small>
                </div>
                <div class="chart-box">
                    <canvas id="trendChart" role="img" aria-label="Completed habits per day"></canvas>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="panel reveal h-100" style="--i:3">
                <div class="panel-title">
                    <h2><i class="bi bi-pie-chart me-2 text-success"></i>By category</h2>
                </div>
                @if (Model.ByCategory.All(p => p.Value == 0))
                {
                    <p class="text-muted">No completed check-in yet.</p>
                }
                else
                {
                    <div class="chart-box">
                        <canvas id="categoryChart" role="img" aria-label="Check-ins per category"></canvas>
                    </div>
                }
            </section>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="panel reveal" style="--i:4">
                <div class="panel-title">
                    <h2><i class="bi bi-list-ol me-2 text-warning"></i>Habit leaderboard</h2>
                    <div class="search-box" style="min-width:200px">
                        <i class="bi bi-search"></i>
                        <input type="search" class="form-control form-control-sm" placeholder="Filter..." data-filter-input aria-label="Filter habits" />
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-modern">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Habit</th>
                                <th style="min-width:160px">Completion</th>
                                <th class="text-center">Streak</th>
                                <th class="text-center">Best</th>
                                <th class="text-center">Check-ins</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Habits)
                            {
                                rank++;
                                <tr data-filter-item data-filter-text="@($"{item.Habit.Name} {item.Habit.Category?.Name} {item.Habit.User?.Name}")">
                                    <td class="fw-bold text-muted">
                                        @* Medals only for habits that have actually been done *@
                                        @if (rank <= 3 && item.TotalCompletions > 0)
                                        {
                                            <span title="Top @rank">@(rank == 1 ? "🥇" : rank == 2 ? "🥈" : "🥉")</span>
                                        }
                                        else
                                        {
                                            @rank
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Habits" asp-action="Details" asp-route-id="@item.Habit.Id" class="fw-semibold text-reset">@item.Habit.Name</a>
                                        <div class="small text-muted">
                                            @item.Habit.Category?.Name
                                            @if (isAdmin)
                                            {
                                                @($" · {item.Habit.User?.Name}")
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress-thin flex-grow-1">
                                                <div class="progress-bar" style="width:0" data-width="@item.CompletionRate.ToString(invariant)"></div>
                                            </div>
                                            <span class="small fw-bold" style="min-width:42px">@item.CompletionRate.ToString("0")%</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="streak @(item.CurrentStreak == 0 ? "is-cold" : "")"><i class="bi bi-fire"></i> @item.CurrentStreak</span>
                                    </td>
                                    <td class="text-center fw-semibold">@item.BestStreak</td>
                                    <td class="text-center fw-semibold">@item.TotalCompletions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small text-center d-none mb-0 mt-3" data-filter-empty>No habit matches.</p>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="panel reveal h-100" style="--i:5">
                <div class="panel-title">
                    <h2><i class="bi bi-calendar-week me-2 text-danger"></i>Best days of the week</h2>
                </div>
                <div class="chart-box chart-box-sm">
                    <canvas id="weekdayChart" role="img" aria-label="Check-ins per weekday"></canvas>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Completion rate = days completed ÷ days since the first record of the habit.
                </p>
            </section>
        </div>
    </div>
}

@section Scripts {
    @if (Model.Habits.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                const trend = {
                    labels: @Json.Serialize(Model.Trend.Select(p => p.Label)),
                    values: @Json.Serialize(Model.Trend.Select(p => p.Value))
                };
                const categories = {
                    labels: @Json.Serialize(Model.ByCategory.Select(p => p.Label)),
                    values: @Json.Serialize(Model.ByCategory.Select(p => p.Value))
                };
                const weekdays = {
                    labels: @Json.Serialize(Model.ByWeekday.Select(p => p.Label)),
                    values: @Json.Serialize(Model.ByWeekday.Select(p => p.Value))
                };

                HT.chart(document.getElementById('trendChart'), theme => {
                    const ctx = document.getElementById('trendChart').getContext('2d');
                    const gradient = ctx.createLinearGradient(0, 0, 0, 260);
                    gradient.addColorStop(0, theme.primary + '55');
                    gradient.addColorStop(1, theme.primary + '00');

                    return {
                        type: 'line',
                        data: {
                            labels: trend.labels,
                            datasets: [{
                                label: 'Habits done',
                                data: trend.values,
                                borderColor: theme.primary,
                                backgroundColor: gradient,
                                fill: true,
                                tension: .35,
                                pointRadius: 0,
                                pointHoverRadius: 5,
                                borderWidth: 2.5
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            interaction: { intersect: false, mode: 'index' },
                            plugins: { legend: { display: false } },
                            scales: {
                                x: { grid: { display: false }, ticks: { maxTicksLimit: 8, maxRotation: 0 } },
                                y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: theme.grid } }
                            }
                        }
                    };
                });

                HT.chart(document.getElementById('categoryChart'), theme => ({
                    type: 'doughnut',
                    data: {
                        labels: categories.labels,
                        datasets: [{
                            data: categories.values,
                            backgroundColor: theme.palette,
                            borderColor: theme.surface,
                            borderWidth: 3,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 14 } } }
                    }
                }));

                HT.chart(document.getElementById('weekdayChart'), theme => ({
                    type: 'bar',
                    data: {
                        labels: weekdays.labels,
                        datasets: [{
                            label: 'Check-ins',
                            data: weekdays.values,
                            backgroundColor: weekdays.values.map(v => v === Math.max(...weekdays.values) && v > 0 ? theme.success : theme.primary),
                            borderRadius: 8,
                            maxBarThickness: 28
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: theme.grid } }
                        }
                    }
                }));
            })();
        </script>
    }
}
