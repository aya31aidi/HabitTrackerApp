@model HabitTrackerApp.Models.HabitStatistic

@{
    ViewData["Title"] = "Create Habit Statistic";
}

<h1 class="mb-4">Create Habit Statistic</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="TotalCompletions" class="form-label"></label>
                        <input asp-for="TotalCompletions" class="form-control" placeholder="e.g., 10" />
                        <span asp-validation-for="TotalCompletions" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Streak" class="form-label"></label>
                        <input asp-for="Streak" class="form-control" placeholder="e.g., 5" />
                        <span asp-validation-for="Streak" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CompletionRate" class="form-label"></label>
                        <input asp-for="CompletionRate" class="form-control" placeholder="e.g., 75.5" />
                        <span asp-validation-for="CompletionRate" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="HabitId" class="form-label"></label>
                        <select asp-for="HabitId" class="form-select" asp-items="ViewBag.HabitId"></select>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Create Statistic</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}