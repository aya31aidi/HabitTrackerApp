@model HabitTrackerApp.Models.HabitStatistic

@{
    ViewData["Title"] = "Edit Habit Statistic";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0"><i class="bi bi-graph-up"></i> Edit Habit Statistic</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="TotalCompletions" class="form-label"></label>
                    <input asp-for="TotalCompletions" class="form-control" />
                    <span asp-validation-for="TotalCompletions" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Streak" class="form-label"></label>
                    <input asp-for="Streak" class="form-control" />
                    <span asp-validation-for="Streak" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CompletionRate" class="form-label"></label>
                    <input asp-for="CompletionRate" class="form-control" />
                    <span asp-validation-for="CompletionRate" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HabitId" class="form-label">Habit</label>
                    <select asp-for="HabitId" class="form-select" asp-items="ViewBag.HabitId">
                        <option value="">-- Select Habit --</option>
                    </select>
                    <span asp-validation-for="HabitId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}