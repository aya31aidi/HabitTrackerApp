@model HabitTrackerApp.Models.HabitStatistic

@{
    ViewData["Title"] = "Delete Habit Statistic";
}

<h1 class="text-danger mb-4">⚠️ Delete Habit Statistic</h1>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this habit statistic?</strong> This action is irreversible.
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Statistic Details</h5>
        <dl class="row mb-0">
            <dt class="col-sm-4">Total Completions</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.TotalCompletions)</dd>

            <dt class="col-sm-4">Streak</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Streak)</dd>

            <dt class="col-sm-4">Completion Rate</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CompletionRate)%</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-danger">✅ Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">❌ Cancel</a>
    </div>
</form>
