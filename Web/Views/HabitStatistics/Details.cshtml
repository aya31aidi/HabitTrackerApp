@model HabitTrackerApp.Models.HabitStatistic

@{
    ViewData["Title"] = "Habit Statistic Details";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Habit Statistic Details</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-secondary">Total Completions</dt>
                <dd class="col-sm-8">@Model.TotalCompletions</dd>

                <dt class="col-sm-4 text-secondary">Streak</dt>
                <dd class="col-sm-8">@Model.Streak days</dd>

                <dt class="col-sm-4 text-secondary">Habit</dt>
                <dd class="col-sm-8">@Model.Habit?.Name</dd>


                <dt class="col-sm-4 text-secondary">Completion Rate</dt>
                <dd class="col-sm-8">@Model.CompletionRate %</dd>
            </dl>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>
</div>
