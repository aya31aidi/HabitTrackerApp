@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = "Edit Habit";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Back to the habit</a>
<div class="page-header">
    <div>
        <h1>Edit habit</h1>
        <p>History and streaks are kept, only the details change.</p>
    </div>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-ghost text-danger">
        <i class="bi bi-trash me-1"></i> Delete
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel reveal">
            <form asp-action="Edit" method="post" data-loading>
                <partial name="_HabitForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Save changes" }' />
            </form>
        </div>
    </div>
    <div class="col-lg-5 d-none d-lg-block">
        <partial name="_HabitPreview" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
