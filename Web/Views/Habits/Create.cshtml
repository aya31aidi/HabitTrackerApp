@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = "New Habit";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Habits</a>
<div class="page-header">
    <div>
        <h1>Create a new habit</h1>
        <p>Give it a clear name, pick a category and it shows up on the dashboard right away.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel reveal">
            <form asp-action="Create" method="post" data-loading>
                <partial name="_HabitForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Create habit" }' />
            </form>
        </div>
    </div>
    <div class="col-lg-5 d-none d-lg-block">
        <partial name="_HabitPreview" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
