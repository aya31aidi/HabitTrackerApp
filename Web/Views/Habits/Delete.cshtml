@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = "Delete Habit";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Back to the habit</a>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="panel danger-card reveal">
            <div class="danger-icon"><i class="bi bi-trash3"></i></div>
            <h1 class="h3">Delete "@Model.Name"?</h1>
            <p class="text-muted">This action is irreversible. The whole history of this habit goes away with it.</p>

            <dl class="detail-list my-4">
                <div><dt>Category</dt><dd><span class="chip @CategoryStyle.Tone(Model.CategoryId)">@Model.Category?.Name</span></dd></div>
                <div><dt>Goal</dt><dd>@(string.IsNullOrWhiteSpace(Model.Goal) ? "—" : Model.Goal)</dd></div>
                <div><dt>Owner</dt><dd>@Model.User?.Email</dd></div>
                <div><dt>Records that will be removed</dt><dd>@Model.HabitRecords.Count</dd></div>
                <div><dt>Reminders that will be removed</dt><dd>@Model.Reminders.Count</dd></div>
            </dl>

            <form asp-action="Delete" method="post" data-loading>
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger" data-loading-text="Deleting...">
                        <i class="bi bi-trash me-1"></i> Yes, delete it
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Keep it</a>
                </div>
            </form>
        </div>
    </div>
</div>
