@model HabitTrackerApp.Models.Habit

@{
    ViewData["Title"] = "Delete Habit";
}

<h1 class="text-danger mb-4">⚠️ Delete Habit</h1>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this habit?</strong> This action is irreversible.
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Habit Details</h5>
        <dl class="row mb-0">
            <dt class="col-sm-4">Habit Name</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Category.Name)</dd>

            <dt class="col-sm-4">Goal</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Goal)</dd>

            <dt class="col-sm-4">User</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.User.Email)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-danger">✅ Delete Habit</button>
        <a asp-action="Index" class="btn btn-outline-secondary">❌ Cancel</a>
    </div>
</form>
