@model HabitTrackerApp.Models.Habit
@{
    var submitText = ViewData["SubmitText"] as string ?? "Save";
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label">Habit name</label>
    <div class="input-icon">
        <i class="bi bi-check2-circle"></i>
        <input asp-for="Name" class="form-control" placeholder="e.g. Read 20 pages" maxlength="100" data-preview="name" autofocus />
    </div>
    <span asp-validation-for="Name" class="small"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label"></label>
    <div class="input-icon">
        <i class="bi bi-tag"></i>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" data-preview="category">
            <option value="">Select a category</option>
        </select>
    </div>
    <span asp-validation-for="CategoryId" class="small"></span>
</div>

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <label asp-for="Goal" class="form-label">Goal <span class="text-muted fw-normal">(optional)</span></label>
        <small class="text-muted" data-char-output="Goal"></small>
    </div>
    <textarea asp-for="Goal" class="form-control" rows="3" maxlength="255" data-char-count="255" data-preview="goal"
              placeholder="Why does it matter? e.g. Finish 12 books this year"></textarea>
    <span asp-validation-for="Goal" class="small"></span>
</div>

@if (User.IsAdmin())
{
    <div class="mb-3">
        <label asp-for="UserId" class="form-label">Owner</label>
        <div class="input-icon">
            <i class="bi bi-person"></i>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                <option value="">Select a user</option>
            </select>
        </div>
        <span asp-validation-for="UserId" class="small"></span>
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-4">
    <button type="submit" class="btn btn-primary" data-loading-text="Saving...">
        <i class="bi bi-check-lg me-1"></i> @submitText
    </button>
    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
</div>
