@model HabitTrackerApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
        @TempData["SuccessMessage"]
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById("successMessage");
                if (alertBox) {
                    alertBox.style.display = "none";
                }
            }, 5000); // 5 seconds
        </script>
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorMessage">
        @TempData["ErrorMessage"]
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById("errorMessage");
                if (alertBox) {
                    alertBox.style.display = "none";
                }
            }, 5000); // 5 seconds
        </script>
}


<div class="container d-flex justify-content-center align-items-center min-vh-100">

    <div class="card shadow-lg p-4" style="width: 100%; max-width: 500px;">
        <div class="text-center mb-3">
    <img src="https://r2.erweima.ai/imgcompressed/compressed_a7b893303e5edb4ac59e42fd4ffe092e.webp" alt="App Logo" style="max-width: 160px; height: 160px;" />
</div>
        @* <h2 class="text-center text-primary mb-4">🔐Login</h2> *@

        <form asp-action="Login" method="post">
            <div class="form-group mb-3">
                <label asp-for="Role" class="form-label">Login as</label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="">-- Select Role --</option>
                    <option value="Admin">Admin</option>
                    <option value="User">User</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>

        <div class="text-center mt-3">
            <p class="mb-1">Don't have an account?</p>
            <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Register">
                Create an Account
            </a>
        </div>
    </div>
</div>

