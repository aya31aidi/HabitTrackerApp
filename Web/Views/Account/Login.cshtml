@model HabitTrackerApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<a class="brand d-lg-none" asp-controller="Home" asp-action="Index">
    <span class="brand-logo"><i class="bi bi-check2-all"></i></span>
    HabitTracker
</a>

<h1 class="mb-1">Welcome back 👋</h1>
<p class="text-muted mb-4">Sign in to keep the streak going.</p>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" data-loading novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" autofocus />
        </div>
        <span asp-validation-for="Email" class="small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
            <button type="button" class="input-action" data-password-toggle="Password" aria-label="Show password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="small"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2" data-loading-text="Signing in...">
        Sign in <i class="bi bi-arrow-right ms-1"></i>
    </button>
</form>

<div class="divider-text my-4">New here?</div>

<a class="btn btn-ghost w-100 py-2" asp-controller="Account" asp-action="Register">
    <i class="bi bi-person-plus me-1"></i> Create a free account
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
