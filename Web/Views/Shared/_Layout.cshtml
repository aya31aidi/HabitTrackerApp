@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var isAdmin = User.IsAdmin();
    var signedIn = User.Identity?.IsAuthenticated == true;

    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · HabitTracker</title>

    @* Applied before the CSS loads so dark mode doesn't flash white *@
    <script>
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('ht-theme'); } catch (e) { }
            var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-bs-theme', saved || (dark ? 'dark' : 'light'));
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body data-reminders-url="@(signedIn ? Url.Action("Upcoming", "Reminders") : "")">

    <aside class="app-sidebar" aria-label="Main navigation">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-logo"><i class="bi bi-check2-all"></i></span>
            HabitTracker
        </a>

        <nav class="app-nav nav flex-column">
            <div class="nav-section">Overview</div>
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> Dashboard
            </a>
            <a class="nav-link @Active("Habits")" asp-controller="Habits" asp-action="Index">
                <i class="bi bi-check2-circle"></i> Habits
            </a>
            <a class="nav-link @Active("HabitStatistics")" asp-controller="HabitStatistics" asp-action="Index">
                <i class="bi bi-bar-chart-line"></i> Statistics
            </a>

            <div class="nav-section">Tracking</div>
            <a class="nav-link @Active("HabitRecords")" asp-controller="HabitRecords" asp-action="Index">
                <i class="bi bi-journal-check"></i> History
            </a>
            <a class="nav-link @Active("Reminders")" asp-controller="Reminders" asp-action="Index">
                <i class="bi bi-alarm"></i> Reminders
            </a>
            <a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index">
                <i class="bi bi-tags"></i> Categories
            </a>

            @if (isAdmin)
            {
                <div class="nav-section">Administration</div>
                <a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> Users
                </a>
            }
        </nav>

        @if (signedIn)
        {
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <span class="avatar">@User.GetInitials()</span>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-bold text-truncate">@User.GetDisplayName()</div>
                        <small class="text-truncate">@(isAdmin ? "Administrator" : User.GetEmail())</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-icon btn-sm text-white-50" title="Sign out" aria-label="Sign out">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </aside>
    <div class="sidebar-backdrop"></div>

    <div class="app-main">
        <header class="app-topbar">
            <button class="btn btn-ghost btn-icon d-lg-none" type="button" data-sidebar-toggle aria-label="Open menu">
                <i class="bi bi-list fs-5"></i>
            </button>

            <div class="me-auto text-truncate">
                <span class="fw-bold text-truncate d-block">@ViewData["Title"]</span>
                <small class="text-muted d-none d-sm-block">@DateTime.Today.ToString("dddd, MMMM d")</small>
            </div>

            <a class="btn btn-primary d-none d-md-inline-flex align-items-center gap-1" asp-controller="Habits" asp-action="Create">
                <i class="bi bi-plus-lg"></i> New habit
            </a>

            <button class="btn btn-ghost btn-icon theme-toggle" type="button" data-theme-toggle title="Toggle dark mode" aria-label="Toggle dark mode">
                <i class="bi bi-moon-stars-fill"></i>
                <i class="bi bi-sun-fill"></i>
            </button>

            @if (signedIn)
            {
                <div class="dropdown">
                    <button class="btn p-0 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                        <span class="avatar">@User.GetInitials()</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="px-3 py-2">
                            <div class="fw-bold">@User.GetDisplayName()</div>
                            <small class="text-muted">@User.GetEmail()</small>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Habits" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>New habit</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Reminders" asp-action="Create"><i class="bi bi-alarm me-2"></i>New reminder</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Home" asp-action="Privacy"><i class="bi bi-shield-lock me-2"></i>Privacy</a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
        </header>

        <main class="app-content">
            @RenderBody()
        </main>

        <footer class="app-footer d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year HabitTracker · Small steps, every day.</span>
            <span class="d-none d-md-inline">Press <span class="kbd-hint">/</span> to search</span>
        </footer>
    </div>

    @* Shared token for the fetch() calls in site.js *@
    <form id="af-token" class="d-none">@Html.AntiForgeryToken()</form>

    <partial name="_Toasts" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
