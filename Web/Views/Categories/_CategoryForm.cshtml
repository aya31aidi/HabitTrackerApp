@model HabitTrackerApp.Models.Category
@{
    var submitText = ViewData["SubmitText"] as string ?? "Save";
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-4">
    <label asp-for="Name" class="form-label">Category name</label>
    <div class="input-icon">
        <i class="bi bi-tag"></i>
        <input asp-for="Name" class="form-control" placeholder="e.g. Health, Learning, Work" maxlength="100" autofocus />
    </div>
    <span asp-validation-for="Name" class="small"></span>
    <div class="form-text">Names like "Sport", "Reading" or "Sleep" get a matching icon automatically.</div>
</div>

<div class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-primary" data-loading-text="Saving...">
        <i class="bi bi-check-lg me-1"></i> @submitText
    </button>
    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
</div>
