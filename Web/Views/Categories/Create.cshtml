@model HabitTrackerApp.Models.Category

@{
    ViewData["Title"] = "New Category";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Categories</a>
<div class="page-header">
    <div>
        <h1>Create a category</h1>
        <p>Categories are shared by every user of the app.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Create" method="post" data-loading>
                <partial name="_CategoryForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Create category" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
