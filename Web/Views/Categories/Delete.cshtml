@model HabitTrackerApp.Models.Category

@{
    ViewData["Title"] = "Delete Category";
    var habitCount = Model.Habits.Count;
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Categories</a>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="panel danger-card reveal">
            <div class="danger-icon"><i class="bi bi-trash3"></i></div>
            <h1 class="h3">Delete "@Model.Name"?</h1>

            @if (habitCount > 0)
            {
                <div class="alert alert-danger d-flex gap-2 align-items-start">
                    <i class="bi bi-exclamation-octagon mt-1"></i>
                    <div>
                        <strong>@habitCount @(habitCount == 1 ? "habit belongs" : "habits belong") to this category.</strong>
                        @(habitCount == 1 ? "It" : "They") will be deleted as well, with all records and reminders, for every user.
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">This category is empty, nothing else will be affected.</p>
            }

            <form asp-action="Delete" method="post" class="mt-4" data-loading>
                <input type="hidden" asp-for="Id" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger" data-loading-text="Deleting...">
                        <i class="bi bi-trash me-1"></i> Yes, delete it
                    </button>
                    <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
