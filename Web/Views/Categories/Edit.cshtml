@model HabitTrackerApp.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<a asp-action="Index" class="breadcrumb-link"><i class="bi bi-arrow-left"></i> Categories</a>
<div class="page-header">
    <div>
        <h1>Rename category</h1>
        <p>The habits inside it stay untouched.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <div class="panel reveal">
            <form asp-action="Edit" method="post" data-loading>
                <partial name="_CategoryForm" model="Model" view-data='new ViewDataDictionary(ViewData) { ["SubmitText"] = "Save changes" }' />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
